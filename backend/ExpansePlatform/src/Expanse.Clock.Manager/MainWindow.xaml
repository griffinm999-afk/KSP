                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="None" />
                      </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                      <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="MinHeight" Value="64" />
                      </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="AUTOMATIC ORDER" Width="1.7*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding Identity}" TextWrapping="Wrap" />
                              <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="STATE &amp; NEXT LAUNCH" Width="1.6*">
