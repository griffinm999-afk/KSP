                  </DataGrid>
                  <TextBlock x:Name="IssuesEmptyText" Text="No delivery issues reported." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border x:Name="AutomaticOrdersCard" Style="{StaticResource Card}" VerticalAlignment="Top" BorderBrush="#087F8C" BorderThickness="3,1,1,1">
                <StackPanel>
