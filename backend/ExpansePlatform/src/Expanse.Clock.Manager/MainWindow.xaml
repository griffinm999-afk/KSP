                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                              <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Text="{Binding NextLaunch}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="ESTIMATED ARRIVAL" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="13" Foreground="{StaticResource InkBrush}" Text="{Binding EstimatedArrival}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="SelectedOrderText" Text="Select an automatic order to manage it." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,7" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button x:Name="EditSelectedOrderButton" Content="Edit selected" Padding="14,6" Click="EditOrder_Click" />
                    <Button x:Name="ToggleSelectedOrderButton" Content="Pause selected" Padding="14,6" Margin="8,0,0,0" Click="ToggleOrder_Click" />
                    <Button x:Name="CancelSelectedOrderButton" Content="Cancel selected…" Padding="14,6" Margin="8,0,0,0" Click="CancelOrder_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="AutomaticOrdersEmptyText" Text="No automatic orders have been saved." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border x:Name="SavedRoutesCard" Style="{StaticResource Card}" VerticalAlignment="Top" BorderBrush="#087F8C" BorderThickness="3,1,1,1">
