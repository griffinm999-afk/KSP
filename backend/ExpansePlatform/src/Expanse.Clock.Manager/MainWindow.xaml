<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Expanse.Clock.Manager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Expanse.Clock.Manager" Title="Expanse Foundations" Icon="Assets/expanse-foundations.ico" Width="1180" Height="930" MinWidth="860" MinHeight="680" Background="#F2F6F7" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources><local:InsetWidthConverter x:Key="InsetWidthConverter" /></Window.Resources>
  <Grid Background="#F2F6F7">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="#163A4B" Padding="16,8">
      <Grid MaxWidth="1180">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Background="#F1F7F7" CornerRadius="9" Padding="5" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,12,0">
          <Image x:Name="AppLogoImage" Source="Assets/expanse-foundations-logo.png" Width="38" Height="38" Stretch="Uniform" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="EXPANSE FOUNDATIONS" FontSize="18" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="SETTLEMENT OPERATIONS" FontSize="11" FontWeight="SemiBold" Foreground="#A8CFD5" Margin="0,2,0,0" />
        </StackPanel>
        <Border x:Name="HeaderConnectionPill" Grid.Column="2" Background="#265263" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
          <TextBlock Text="OPERATIONS CONSOLE" Foreground="#C5E8E8" FontSize="11" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" MaxWidth="1180" Margin="24,16,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Background="#E5F1F2" BorderBrush="#C6E0E1" Padding="10,5" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <DockPanel LastChildFill="True"><TextBlock Text="OPERATIONS DATE" Foreground="#426674" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock x:Name="ClockText" Text="Waiting for KSP" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" /></DockPanel>
            <TextBlock x:Name="SaveText" Text="Open KSP and load your save to connect." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Expander Header="Connection details" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Margin="20,6,0,0">
              <TextBlock x:Name="RawUtText" Text="UT —" />
              <TextBlock x:Name="IdentityText" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
      <TabControl x:Name="NavTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
        <TabItem Header="Manage colony"><local:ColonyManagementView x:Name="ColonyManagementControl"/></TabItem>
        <TabItem Header="Colony">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Background="White" Padding="14,8" Margin="0,0,0,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="SETTLEMENT OPERATIONS" Foreground="#087F8C" FontSize="11" FontWeight="Bold" /><TextBlock x:Name="ColonyTitleText" Text="Colony overview" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,2,0,0" /><TextBlock x:Name="ColonyFreshnessText" Text="Waiting for observed settlement data." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                  <StackPanel Grid.Column="1" MinWidth="190" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="SITE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,4" /><ComboBox x:Name="ColonyLocationBox" MinWidth="190" Padding="7,5" DisplayMemberPath="Label" SelectionChanged="ColonyLocation_SelectionChanged" ToolTip="Choose a settlement observed in the current save." /></StackPanel>
                </Grid>
              </Border>
            <TabControl x:Name="ColonySubTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,8,0,0">
              <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <Border x:Name="ColonyAttentionCard" Background="#F4F6F7" BorderBrush="#DCE5E8" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,5"><StackPanel><TextBlock x:Name="ColonyAttentionHeadingText" Text="CURRENT FINDINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ColonyAttentionText" Text="Waiting for a current facility observation." FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></Border>
              <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="11,8"><StackPanel><TextBlock Text="FACILITIES" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="ColonyVesselCountText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" /><TextBlock x:Name="ColonyCrewSummaryText" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="3,0" Padding="11,8"><StackPanel><TextBlock Text="PRODUCTION UNITS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="ColonyProductionText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" /><TextBlock x:Name="ColonyProductionDetailText" Text="Not observed" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="3,0" Padding="11,8"><StackPanel><TextBlock Text="STORED ENERGY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" /><TextBlock x:Name="ColonyPowerDetailText" Text="No reading" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0" Padding="11,8"><StackPanel><TextBlock Text="MACHINERY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="ColonyMachineryText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" /><TextBlock Text="Installed / stored" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
              </UniformGrid>
              <Border Style="{StaticResource Card}" Padding="14,11">
                <StackPanel><Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Facilities at this site" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" /><TextBlock x:Name="ColonyVesselCountDetailText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
                  <TextBlock x:Name="ColonyVesselsEmptyText" Text="No settlement facilities have been observed at this site." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <ItemsControl x:Name="ColonyVesselsList" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="#F7F9FA" BorderBrush="#DCE5E8" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                      <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource InkBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding CrewText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,2,0,0" TextWrapping="Wrap" TextAlignment="Right" /></Grid>
                        <ItemsControl ItemsSource="{Binding Resources}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RawName}" /><ProgressBar Grid.Column="1" Height="7" Minimum="0" Maximum="100" Value="{Binding FillPercent}" Foreground="#AAB8BD" Background="#E5EBED" BorderThickness="0" VerticalAlignment="Center" Margin="7,0" /><TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{Binding EmptyResourcesText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                        <Expander Header="Technical details" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"><StackPanel Margin="16,5,0,0"><TextBlock Text="{Binding TechnicalSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding TechnicalResources}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="14,11"><StackPanel><TextBlock Text="Production checks" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" /><TextBlock Text="An enabled switch does not confirm production or rate. Checks use observed storage configuration; no time-to-empty is estimated." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,7" /><TextBlock x:Name="ColonyProductionEmptyText" Text="No converter observations at this site." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" /><ItemsControl x:Name="ColonyProductionList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F7F9FA" BorderBrush="#DCE5E8" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding VesselLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding FlowText}" FontSize="10" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="9,0" /><StackPanel Grid.Column="2" Margin="9,0,0,0"><TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Diagnosis}" FontSize="10" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
              <Border Background="#EAF3F4" BorderBrush="#C6E0E1" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,0,8"><TextBlock Text="Physical tank readings are a once-per-facility snapshot. WOLF capacity appears on the WOLF tab and is excluded from physical totals." Foreground="#426674" FontSize="10" TextWrapping="Wrap" /></Border>
                </StackPanel></ScrollViewer>
              </TabItem>
              <TabItem Header="WOLF">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Grid.Row="0" Style="{StaticResource Card}" Background="#F2F7F7" Padding="10,6" Margin="0,0,0,6" ToolTip="WOLF biome capacity is separate from physical tank stock and electrical power (EC).">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="WOLF DEPOT CAPACITY" Foreground="#087F8C" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" x:Name="WolfFreshnessText" Text="Waiting for WOLF ledger observation." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                  <Expander Grid.Row="1" Header="Adjust capacity" IsExpanded="False" Background="White" BorderBrush="#DCE9EC" BorderThickness="1" Padding="9,5" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="#087F8C"><StackPanel Margin="0,7,0,2">
                    <TextBlock Text="Add capacity or set its total supply. Existing allocations stay in place. Save KSP after applying changes." Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="RESOURCE" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="WolfResourceBox" DisplayMemberPath="Resource" Padding="7,5" Margin="0,3,0,0" SelectionChanged="WolfEditor_SelectionChanged" /></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="ACTION" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="WolfTargetBox" Padding="7,5" Margin="0,3,0,0" SelectionChanged="WolfEditor_SelectionChanged"><ComboBoxItem Content="Set total supply" Tag="incoming" /><ComboBoxItem Content="Add capacity" Tag="add" /></ComboBox></StackPanel><StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="AMOUNT" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WolfAmountBox" Padding="7,5" Margin="0,3,0,0" TextChanged="WolfEditor_TextChanged" /></StackPanel><Button x:Name="WolfApplyButton" Grid.Column="3" Content="Apply change" Padding="13,7" Margin="0,17,0,0" Click="WolfApply_Click" /></Grid>
                    <TextBlock x:Name="WolfPreviewText" Text="Choose a resource to preview the capacity change." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock x:Name="WolfCommandStatusText" Text="Choose a resource to adjust, including one not yet supplied here." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel></Expander>
                  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="RESOURCE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="SUPPLY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="ALLOCATED" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="AVAILABLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="WolfResourcesEmptyText" Text="No WOLF virtual depot resources have been observed." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="WolfResourcesList"><ItemsControl.ItemTemplate><DataTemplate>
                      <Border Background="#F7F9FA" BorderBrush="#E3EBED" BorderThickness="1" CornerRadius="5" Padding="8,7" Margin="0,0,0,4" ToolTip="{Binding DetailText}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Resource}" TextWrapping="Wrap" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" /><TextBlock Grid.Column="1" Text="{Binding IncomingText}" FontSize="12" Foreground="{StaticResource InkBrush}" /><TextBlock Grid.Column="2" Text="{Binding OutgoingText}" FontSize="12" Foreground="{StaticResource InkBrush}" /><TextBlock Grid.Column="3" Text="{Binding AvailableText}" FontSize="12" Foreground="{StaticResource InkBrush}" /><TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      </Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  </Grid></Border>

                </Grid>
              </TabItem>
              <TabItem Header="Production">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                  <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8"><StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="RESOURCE OPERATIONS" Foreground="#087F8C" FontSize="13" FontWeight="Bold" /><TextBlock Text="Production and stock" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,2,0,0" /></StackPanel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="FIND A RESOURCE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBox x:Name="ColonyResourceSearchBox" TextChanged="ColonyResourceSearch_TextChanged" Padding="7,5" Margin="0,3,0,0" ToolTip="Filter resource names" /></StackPanel>
                    </Grid>
                    <TextBlock x:Name="ColonyResourceSummaryText" Text="Waiting for a resource observation." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Stock is observed physical storage. Configured inputs and outputs do not confirm production or a rate. Unloaded facilities show their last saved stock; WOLF capacity is shown separately on the WOLF tab." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel></Border>
                  <Border Style="{StaticResource Card}" Padding="14,11"><StackPanel>
                    <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                      <TextBlock Text="RESOURCE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="OBSERVED STOCK" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="OUTPUT UNITS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="INPUT UNITS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock x:Name="ColonyResourcesEmptyText" Text="No resources have been observed at this site." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
                    <ItemsControl x:Name="ColonyResourcesList"><ItemsControl.ItemTemplate><DataTemplate>
                      <Expander Tag="{Binding Key}" IsExpanded="{Binding IsExpanded, Mode=OneWay}" Expanded="ResourceDrill_Expanded" Collapsed="ResourceDrill_Collapsed" Background="#F7F9FA" Margin="0,0,0,5" Padding="7,5">
                        <Expander.Header><Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource InsetWidthConverter}, ConverterParameter=40}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding StockText}" FontSize="12" Foreground="{StaticResource InkBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding OutputCountText}" FontSize="12" Foreground="{StaticResource InkBrush}" />
                          <TextBlock Grid.Column="3" Text="{Binding InputCountText}" FontSize="12" Foreground="{StaticResource InkBrush}" />
                        </Grid></Expander.Header>
                        <StackPanel Margin="15,7,0,4">
                          <TextBlock Text="FACILITY DETAIL" FontSize="10" FontWeight="Bold" Foreground="#087F8C" Margin="0,0,0,4" />
                          <ItemsControl ItemsSource="{Binding Facilities}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="White" BorderBrush="#E3EBED" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,4"><StackPanel>
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" /><TextBlock Grid.Column="1" Text="{Binding ObservationText}" FontSize="10" Foreground="{StaticResource MutedBrush}" /></Grid>
                              <TextBlock Text="{Binding StockText}" FontSize="11" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0" />
                              <TextBlock Text="{Binding FlowText}" FontSize="11" Foreground="{StaticResource InkBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding StorageDetailText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel></Border>
                          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                      </Expander>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel></Border>
                </StackPanel></ScrollViewer>
              </TabItem>
              <TabItem Header="Power">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8">
                <StackPanel>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TRACKED POWER FLOW" Foreground="#087F8C" FontSize="13" FontWeight="Bold" /><TextBlock Text="Generation and consumption (EC/s)" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" /></StackPanel><TextBlock x:Name="ColonyPowerRateFreshnessText" Grid.Column="1" Text="Waiting for observation" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" TextAlignment="Right" /></Grid>
                  <UniformGrid Columns="3" Margin="0,0,0,5">
                    <Border Background="#EDF6F2" CornerRadius="7" Padding="9,7" Margin="0,0,4,0"><StackPanel><TextBlock Text="TRACKED GENERATION" Foreground="#426674" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerGenerationRateText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></Border>
                    <Border Background="#F8F1ED" CornerRadius="7" Padding="9,7" Margin="2,0"><StackPanel><TextBlock Text="TRACKED CONSUMPTION" Foreground="#426674" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerConsumptionRateText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></Border>
                    <Border Background="#EDF3F7" CornerRadius="7" Padding="9,7" Margin="4,0,0,0"><StackPanel><TextBlock Text="TRACKED NET" Foreground="#426674" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerNetRateText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></Border>
                  </UniformGrid>
                  <TextBlock x:Name="ColonyPowerRateDetailText" Text="Partial coverage: direct resource changes and transfers are excluded." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,6" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Tracked EC flow" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerHistoryStatusText" Grid.Column="1" Text="No rate history" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="8,0,0,0" /></Grid>
                  <Border Background="#F7F9FA" BorderBrush="#E3EBED" BorderThickness="1" CornerRadius="5" Margin="0,4,0,0"><Canvas x:Name="ColonyPowerHistoryCanvas" Height="76" SizeChanged="ColonyPowerHistoryCanvas_SizeChanged" ClipToBounds="True" /></Border>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="● Generation" Foreground="#248963" FontSize="10" Margin="0,0,12,0" /><TextBlock Text="● Consumption" Foreground="#BB673C" FontSize="10" Margin="0,0,12,0" /><TextBlock Text="● Net" Foreground="#087F8C" FontSize="10" /></StackPanel>
                  <TextBlock Text="Gaps mark unavailable or interrupted readings." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8">
                <StackPanel>
                  <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="COLONY POWER" Foreground="#087F8C" FontSize="13" FontWeight="Bold" /><TextBlock Text="Stored charge (EC)" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" /></StackPanel><TextBlock x:Name="ColonyPowerFreshnessText" Grid.Column="1" Text="Waiting for observation" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" TextAlignment="Right" /></Grid>
                  <UniformGrid Columns="3" Margin="0,0,0,7">
                    <Border Background="#F7F9FA" CornerRadius="7" Padding="9,7" Margin="0,0,4,0"><StackPanel><TextBlock Text="OBSERVED CHARGE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerChargeText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></Border>
                    <Border Background="#F7F9FA" CornerRadius="7" Padding="9,7" Margin="2,0"><StackPanel><TextBlock Text="OBSERVED CAPACITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerCapacityText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></Border>
                    <Border Background="#F7F9FA" CornerRadius="7" Padding="9,7" Margin="4,0,0,0"><StackPanel><TextBlock Text="CHARGE LEVEL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="ColonyPowerPercentText" Text="—" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></Border>
                  </UniformGrid>
                  <TextBlock Text="Totals combine facility storage; power sharing is not verified." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" />
                  <TextBlock x:Name="ColonyPowerEmptyText" Text="No ElectricCharge tank readings observed at this site." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions><TextBlock Text="FACILITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="7,2" /><TextBlock Grid.Column="1" Text="CHARGE / CAPACITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,2" /><TextBlock Grid.Column="2" Text="LEVEL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,2" /><TextBlock Grid.Column="3" Text="OBSERVATION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="4,2" /></Grid>
                  <ItemsControl x:Name="ColonyPowerFacilitiesList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Expander Tag="{Binding Key}" IsExpanded="{Binding IsExpanded, Mode=OneWay}" Expanded="PowerDrill_Expanded" Collapsed="PowerDrill_Collapsed" Background="#F7F9FA" Margin="0,0,0,4" Padding="4,2">
                      <Expander.Header><Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource InsetWidthConverter}, ConverterParameter=40}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,5" /><TextBlock Grid.Column="1" Text="{Binding ChargeText}" Foreground="{StaticResource InkBrush}" FontSize="13" VerticalAlignment="Center" Margin="4,5" /><TextBlock Grid.Column="2" Text="{Binding PercentText}" Foreground="{StaticResource InkBrush}" FontSize="13" VerticalAlignment="Center" Margin="4,5" /><TextBlock Grid.Column="3" Text="{Binding Freshness}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="4,5" /></Grid></Expander.Header>
                      <StackPanel Margin="20,5,5,7"><TextBlock Text="MEASURED LIVE FLOW" Foreground="#087F8C" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding FlowText}" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding FlowDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="MODULE-RATED ESTIMATE · NOMINAL, PARTIAL" Foreground="#087F8C" FontSize="10" FontWeight="Bold" Margin="0,9,0,0" /><TextBlock Text="{Binding EstimateText}" Foreground="{StaticResource InkBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding EstimateDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding StorageDetail}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    </Expander>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
                </StackPanel></ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>
        <TabItem Header="Depot stock">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Depot stock" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                  <TextBlock Text="One row per registered depot. Each resource column shows available units / capacity from the latest observed snapshot." FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                  <DataGrid x:Name="DepotsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7ECF1" Background="White" BorderBrush="#DCE9EC" RowHeaderWidth="0" MinHeight="100" MaxHeight="520" RowHeight="48" ColumnHeaderHeight="38" FontSize="14" AlternatingRowBackground="#F5F8FB">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="DEPOT" Binding="{Binding Label}" Width="2*" />
                      <DataGridTextColumn Header="LF" Binding="{Binding LiquidFuelText}" Width="1.2*" />
                      <DataGridTextColumn Header="OX" Binding="{Binding OxidizerText}" Width="1.2*" />
                      <DataGridTextColumn Header="MP" Binding="{Binding MonopropellantText}" Width="1.2*" />
                      <DataGridTextColumn Header="ORE" Binding="{Binding OreText}" Width="1.2*" />
                      <DataGridTextColumn Header="STOCK" Binding="{Binding StatusText}" Width="1.1*" />
                      <DataGridTextColumn Header="DETAIL" Binding="{Binding ReasonText}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding ReasonText}" />
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="DepotListMessageText" Text="Waiting for KSP." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                  <TextBlock Text="LF = Liquid Fuel   ·   OX = Oxidizer   ·   MP = Monopropellant   ·   ORE = Ore" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,15,0,0" />
                  <Expander Header="About stock readings" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0">
                    <TextBlock Text="For unloaded depots, Background Resource Processing 0.2.7 projections are used when available; otherwise snapshot stock may lag production. Physical delivery effects require delivery readiness. Loaded depots are not supported for physical delivery effects." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="20,7,0,0" />
                  </Expander>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="DeliverySetupTab" Header="Delivery setup">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="LogisticsStatusText" Text="Connect to a loaded game to edit delivery setup." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap" />
              <Border Style="{StaticResource Card}" BorderBrush="#087F8C" BorderThickness="4,1,1,1">
                <StackPanel>
                  <TextBlock Text="Ore exports to Kerbin" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,10" />
                  <TextBlock Text="Choose the physical Ore quantity for each routine trip at 100 funds per unit. The app simulates travel, landing and recovery; no vessel is spawned. Saving a route configures its terms. Select that saved route below and enable its automatic order to activate exports whenever the complete batch is available." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                  <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource FieldLabel}" Text="Registered source" /><ComboBox x:Name="ExportSourceBox" DisplayMemberPath="Label" SelectionChanged="ExportSource_SelectionChanged" /></StackPanel>
                    <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource FieldLabel}" Text="Export route name" /><TextBox x:Name="ExportRouteIdBox" Text="Minmus Ore recovery" /></StackPanel>
                    <StackPanel Margin="0,0,14,12"><TextBlock Style="{StaticResource FieldLabel}" Text="Travel time (days:hours:minutes)" /><TextBox x:Name="ExportDurationBox" Text="3:00:00" ToolTip="Three six-hour Kerbin days = 64,800 game seconds" /></StackPanel>
                  </UniformGrid>
                  <WrapPanel Margin="0,0,0,12">
                    <StackPanel Margin="0,0,14,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Ore per trip (whole units)" /><TextBox x:Name="ExportQuantityBox" Text="1000" Width="180" TextChanged="ExportQuantity_TextChanged" ToolTip="1 to 1,000,000 whole Ore units" /></StackPanel>
                    <TextBlock x:Name="ExportPayoutPreviewText" Text="1,000 Ore × 100 funds = 100,000 funds at recovery" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Foreground="{StaticResource InkBrush}" />
                  </WrapPanel>
                  <Button x:Name="SaveExportRouteButton" Content="Save Ore export route" HorizontalAlignment="Left" Padding="14,6" Click="SaveExportRoute_Click" />
                  <TextBlock x:Name="ExportPaymentStatusText" Text="No retained recovery payments in the selected save." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                  <TextBlock x:Name="ExportOrderStatusText" Text="No export route selected. Saving a route does not activate exports." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Plan deliveries" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,18" />
                  <StackPanel Margin="0,0,14,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Saved route" />
                    <ComboBox x:Name="RouteVersionBox" DisplayMemberPath="Display" ToolTip="Accepted saved route" SelectionChanged="RouteVersion_SelectionChanged" />
                  </StackPanel>
                  <Border Background="#FFF3DB" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <TextBlock x:Name="DeliveryReadinessText" Text="Checking delivery readiness…" Foreground="#855A16" FontSize="13" TextWrapping="Wrap" />
                  </Border>
                  <Button x:Name="SendOnceButton" Content="Send once · unavailable" Padding="18,10" Margin="0,0,0,18" Click="SendOnce_Click" />
                  <TextBlock Text="Choose a saved route, then send it once or set up automatic orders." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,0,0,16" />
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,14,16">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Schedule name" />
                      <TextBox x:Name="RuleIdBox" Text="Fuel resupply" ToolTip="Name of the automatic order" TextChanged="RuleId_TextChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,16">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="When to order" />
                      <ComboBox x:Name="RuleKindBox" SelectedIndex="0" ToolTip="Schedule type" SelectionChanged="RuleKind_SelectionChanged">
                        <ComboBoxItem Content="Every interval" Tag="repeat" />
                        <ComboBoxItem Content="When stock is low" Tag="keepStock" />
                        <ComboBoxItem Content="When source has the configured Ore batch" Tag="exportStock" />
                      </ComboBox>
                    </StackPanel>
                  </UniformGrid>
                  <StackPanel x:Name="RepeatFields" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repeat every (days:hours:minutes)" />
                    <TextBox x:Name="IntervalBox" Text="1:00:00" ToolTip="KSP time; six hours per day" />
                    <TextBlock Text="Each repeat sends the whole cargo bundle shown in the saved route. The interval may be shorter than travel time, so multiple deliveries can be in transit on the same route. Arrivals recheck destination capacity and may hold remaining cargo if it is full." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                  </StackPanel>
                  <StackPanel x:Name="KeepStockFields" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Resources to keep stocked" />
                    <TextBlock Text="Check each resource to manage. Set a low point and target, or choose Keep full to replace any amount used. Only the resources that need fuel are ordered." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="155" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="RESOURCE" />
                      <TextBlock Grid.Column="1" Text="KEEP FULL" />
                      <TextBlock Grid.Column="2" Text="ORDER BELOW" />
                      <TextBlock Grid.Column="3" Text="FILL TOWARD" />
                      <TextBlock Grid.Column="4" Text="MAX PER TRIP" />
                    </Grid>
                    <ItemsControl x:Name="RuleResourcesList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="190" />
                              <ColumnDefinition Width="110" />
                              <ColumnDefinition Width="155" />
                              <ColumnDefinition Width="155" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding KeepFull, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanKeepFull}" VerticalAlignment="Center" ToolTip="Keep this resource filled to its registered tank capacity" />
                            <TextBox Grid.Column="2" Text="{Binding LowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditThresholds}" Margin="0,0,9,0" ToolTip="Order when destination stock drops below this many units" />
                            <TextBox Grid.Column="3" Text="{Binding TargetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditThresholds}" Margin="0,0,9,0" ToolTip="Stop when stock plus inbound deliveries reaches this target" />
                            <TextBlock Grid.Column="4" Text="{Binding BatchText}" VerticalAlignment="Center" ToolTip="Maximum units in one shipment, taken from the selected route" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="The app saves a separate single-resource route and stock rule for each checked resource. A shortage sends only that resource. Keep full requires a known destination capacity." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                  <TextBlock x:Name="EditingRuleText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#426674" FontSize="12" Margin="0,0,0,8" />
                  <WrapPanel>
                    <Button x:Name="SaveRuleButton" Content="Save automatic order" Padding="14,6" Click="SaveRule_Click" />
                    <Button x:Name="ClearRuleEditButton" Content="Start new order" Padding="14,6" Margin="10,0,0,0" Visibility="Collapsed" Click="ClearRuleEdit_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Expander Header="Create or edit a route" IsExpanded="False" Foreground="#426674" FontSize="14" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" BorderBrush="#E5B053" BorderThickness="4,1,1,1">
                  <StackPanel>
                    <TextBlock Text="Create a route" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,18" />
                    <TextBlock x:Name="SourceAvailabilityText" Text="Kerbin can be selected as a planned supplier. Purchased Kerbin shipments need the external-source scheduler before routes can be saved." Foreground="#855A16" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <UniformGrid Columns="3">
                      <StackPanel Margin="0,0,14,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Route name" />
                        <TextBox x:Name="RouteIdBox" ToolTip="Stable route ID" Text="route-1" />
                      </StackPanel>
                      <StackPanel Margin="0,0,14,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="From" />
                        <ComboBox x:Name="SourceDepotBox" DisplayMemberPath="Label" ToolTip="Supply source" SelectionChanged="SourceDepotBox_SelectionChanged" />
                      </StackPanel>
                      <StackPanel Margin="0,0,14,16">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="To depot" />
                        <ComboBox x:Name="DestinationDepotBox" DisplayMemberPath="Label" ToolTip="Destination depot" />
                      </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Cargo resources" />
                    <TextBlock Text="Select each resource this trip carries and enter its amount in units." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
                    <ItemsControl x:Name="RouteResourcesList" Margin="0,0,0,10">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="240" />
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding DisplayName}" VerticalAlignment="Center" FontSize="14" />
                            <TextBox Grid.Column="1" Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selected}" ToolTip="Cargo amount in resource units" />
                            <TextBlock Grid.Column="2" Text="units" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,0,0,14">
                      <TextBox x:Name="AdditionalResourceBox" Width="220" ToolTip="KSP resource name, e.g. Ore" />
                      <Button Content="Add another resource" Click="AddResource_Click" Margin="8,0,0,0" Padding="12,4" />
                    </WrapPanel>
                    <StackPanel Margin="0,0,14,16">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Travel time (days:hours:minutes)" />
                      <TextBox x:Name="DurationBox" ToolTip="Use KSP time: 6 hours per day (D:HH:MM)" Text="0:01:00" />
                    </StackPanel>
                    <Expander Header="Travel time source (optional note)" Margin="0,0,0,16" Foreground="{StaticResource MutedBrush}">
                      <TextBox x:Name="ProvenanceBox" Text="Estimated travel time" Margin="0,8,0,0" ToolTip="How this travel time was chosen" />
                    </Expander>
                    <WrapPanel>
                      <Button x:Name="SaveRouteButton" Content="Save route version" Padding="14,6" Click="SaveRoute_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Activity">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border x:Name="OutstandingDeliveriesCard" Style="{StaticResource Card}" VerticalAlignment="Top" BorderBrush="#087F8C" BorderThickness="3,1,1,1">
                <StackPanel>
                  <TextBlock Text="Deliveries in transit" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,7" />
                  <TextBlock Text="Track cargo, arrival estimates and countdowns against the KSP clock." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
                  <DataGrid x:Name="DeliveriesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7ECF1" Background="White" BorderBrush="#E7ECF1" RowHeaderWidth="0" MinHeight="60" MaxHeight="360" ColumnHeaderHeight="38" FontSize="13" AlternatingRowBackground="#F5F8FB">
                    <DataGrid.Resources>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="None" />
                      </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                      <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="MinHeight" Value="64" />
                      </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                      <DataGridTemplateColumn Header="DELIVERY" Width="1.25*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding RouteName}" TextWrapping="Wrap" />
                              <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Text="{Binding Destination}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="CARGO" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#617787" Text="CARGO REMAINING" Margin="0,0,0,3" />
                              <TextBlock FontSize="13" Text="{Binding Cargo}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="ARRIVAL &amp; COUNTDOWN" Width="1.7*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding ArrivalDate}" TextWrapping="Wrap" />
                              <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Text="{Binding Countdown}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="STATUS" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Margin="4,7,8,7">
                              <TextBlock FontSize="13" Foreground="{StaticResource InkBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock x:Name="DeliveriesEmptyText" Text="No deliveries are in transit. New departures will appear here." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border x:Name="DeliveryIssuesCard" Style="{StaticResource Card}" VerticalAlignment="Top" BorderBrush="#D29A3A" BorderThickness="3,1,1,1">
                <StackPanel>
                  <TextBlock Text="Delivery issues" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,7" />
                  <TextBlock Text="Readiness and arrival faults reported for individual deliveries." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
                  <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7ECF1" Background="White" BorderBrush="#E7ECF1" RowHeaderWidth="0" MinHeight="60" MaxHeight="360" ColumnHeaderHeight="38" FontSize="13" AlternatingRowBackground="#F5F8FB">
                    <DataGrid.Resources>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="None" />
