                  <TextBlock Text="Recurring and stock-triggered orders for your depots." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
                  <DataGrid x:Name="AutomaticOrdersGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="AutomaticOrders_SelectionChanged" PreviewMouseRightButtonDown="AutomaticOrders_PreviewMouseRightButtonDown" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7ECF1" Background="White" BorderBrush="#E7ECF1" RowHeaderWidth="0" MinHeight="60" MaxHeight="360" ColumnHeaderHeight="38" FontSize="13" AlternatingRowBackground="#F5F8FB">
