<UserControl x:Class="Expanse.Clock.Manager.ColonyManagementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" Foreground="#173345" Background="#F2F6F7" UseLayoutRounding="True" SizeChanged="Layout_SizeChanged">
 <UserControl.Resources>

  <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#617787"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="MinRowHeight" Value="34"/><Setter Property="BorderBrush" Value="#DCE5E8"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7F9FA"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="7,5"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
  <DataTemplate x:Key="OperationFieldTemplate"><StackPanel Margin="0,0,8,6"><TextBlock Text="{Binding Label}" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Help}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsChoiceField}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="BorderBrush" Value="#A33325"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Help}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChoiceField}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="BorderBrush" Value="#A33325"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><TextBlock Text="{Binding Issue}" Visibility="{Binding IssueVisibility}" FontSize="11" FontWeight="SemiBold" Foreground="#A33325" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Help}" FontSize="10" Foreground="#617787" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding MetricDetailVisibility,RelativeSource={RelativeSource AncestorType=UserControl}}"/></StackPanel></DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DBE7EB" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="COLONY MANAGEMENT" Foreground="#087F8C" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ConnectionText" Text="Disconnected" FontWeight="SemiBold" FontSize="16" Margin="0,3,8,0"/><TextBlock x:Name="ConnectionReasonText" Text="Waiting to connect to this KSP save." FontSize="11" Foreground="#617787" TextWrapping="Wrap" Margin="0,3,8,0"/></StackPanel>
    <ComboBox x:Name="ColonyPicker" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ColonyPicker_SelectionChanged" VerticalAlignment="Center" ToolTip="Registered colony identity; separate sites stay distinct."/>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" SelectionChanged="Navigation_SelectionChanged" Margin="0,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,8"><TextBlock x:Name="SectionTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SectionSummary" Foreground="#617787" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/><DockPanel x:Name="WorkflowPickerPanel" Margin="0,8,8,0" Visibility="Collapsed"><TextBlock Text="TASK" FontSize="10" FontWeight="SemiBold" Foreground="#617787" Margin="0,0,12,0" VerticalAlignment="Center"/><ComboBox x:Name="WorkflowPicker" DisplayMemberPath="Name" SelectedValuePath="Key" SelectionChanged="Workflow_SelectionChanged" Padding="5,3" ToolTip="Choose what you want to do; related fields and reviewed actions appear below."/></DockPanel><CheckBox x:Name="AdvancedPlanningToggle" Content="Show new construction and advanced planning" Checked="AdvancedPlanning_Changed" Unchecked="AdvancedPlanning_Changed" FontSize="11" Margin="0,6,0,0" ToolTip="Shows optional paid construction, startup and WOLF capacity planning. Existing facilities, trade and service remain available."/><Border x:Name="TaskNoticePanel" Background="#FFF2E9" BorderBrush="#AF3D28" BorderThickness="0,0,0,0" Padding="8,6" Margin="0,7,8,0" Visibility="Collapsed"><TextBlock x:Name="TaskNoticeText" TextWrapping="Wrap" Foreground="#8A2920" FontSize="11"/></Border><TextBlock x:Name="TaskFeedbackText" TextWrapping="Wrap" Foreground="#8A2920" FontWeight="SemiBold" FontSize="11" Margin="0,4,8,0" Visibility="Collapsed"/></StackPanel>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="FormRow" Height="Auto"/><RowDefinition x:Name="RecordsRow" Height="Auto"/></Grid.RowDefinitions>
     <ItemsControl x:Name="OverviewMetrics" Grid.Row="0" Margin="0,0,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding MetricColumns,RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="Metric_Click" Background="White" Foreground="#173345" Padding="10,7" Margin="0,0,7,7" HorizontalContentAlignment="Stretch"><Button.ToolTip><StackPanel><TextBlock Text="{Binding Value}"/><TextBlock Text="{Binding Detail}"/><TextBlock Text="{Binding Basis}"/></StackPanel></Button.ToolTip><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#DBE7EB" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Button.Template><StackPanel><TextBlock Text="{Binding Label}" FontSize="10" Foreground="#617787" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Value}" FontSize="{Binding MetricValueSize,RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Foreground="#173345" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#426674" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding MetricDetailVisibility,RelativeSource={RelativeSource AncestorType=UserControl}}"/><TextBlock Text="{Binding Basis}" FontSize="9" Foreground="#617787" Margin="0,3,0,0" Visibility="{Binding MetricDetailVisibility,RelativeSource={RelativeSource AncestorType=UserControl}}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ScrollViewer x:Name="FormPanel" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border x:Name="DraftPanel" Visibility="Collapsed" Margin="0,0,0,8">
      <StackPanel Background="White" Margin="0,0,7,0">
        <TextBlock x:Name="DraftIntroText" Text="Name the settlement and choose its site. An empty charter starts with no residents, buildings, supplies or new funds. Add each when you choose that task." FontSize="11" TextWrapping="Wrap" Foreground="#617787" Margin="8"/>
        <Expander x:Name="CharterAdoptionPanel" Header="Use an existing facility site (optional)" IsExpanded="False" Margin="8,0,16,8"><DockPanel Margin="0,6,0,8"><Button DockPanel.Dock="Right" Content="Use this facility's site" Tag="{Binding SelectedValue, ElementName=FoundingSitePicker}" Click="UseFacilitySite_Click" Padding="8,4" Margin="8,0,0,0" ToolTip="Copy the selected current facility's site. This does not adopt assets or approve purchases."/><ComboBox x:Name="FoundingSitePicker" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Choose a current observed facility by name, then copy its site."/></DockPanel></Expander>
       <UniformGrid x:Name="CharterFieldsGrid" Columns="2" Margin="8,0,8,8">
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Colony name" Style="{StaticResource SmallLabel}"/><TextBox x:Name="CharterNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Margin="0,0,8,8"><TextBlock Text="Purpose" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       </UniformGrid>
        <UniformGrid Columns="2" Margin="8,0,8,8">
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Body" Style="{StaticResource SmallLabel}"/><TextBox x:Name="CharterBodyInput" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Biome" Style="{StaticResource SmallLabel}"/><TextBox x:Name="CharterBiomeInput" Text="{Binding Biome, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="An empty site still needs exact coordinates for the current boundary and overlap checks. No location is guessed from the biome." FontSize="10" Foreground="#617787" TextWrapping="Wrap" Margin="8,0,16,5"/>
        <Expander Header="Exact site coordinates (required for an empty site)" IsExpanded="False" Margin="8,0,16,8"><UniformGrid Columns="2">
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Latitude (degrees)" Style="{StaticResource SmallLabel}"/><TextBox x:Name="CharterLatitudeInput" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Longitude (degrees)" Style="{StaticResource SmallLabel}"/><TextBox x:Name="CharterLongitudeInput" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        </UniformGrid></Expander>
       <Expander x:Name="CharterAdvanced" Header="Advanced charter policy — defaults" IsExpanded="False" Margin="8,0,16,8"><StackPanel>
        <TextBlock x:Name="CharterPolicySummary" Text="All policy terms appear in the charter review." FontSize="10" Foreground="#617787" TextWrapping="Wrap" Margin="0,5,0,8"/>
         <UniformGrid Columns="2"><StackPanel Margin="0,0,8,8"><TextBlock Text="Resident target (starts at zero)" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding Population, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Margin="0,0,8,8"><TextBlock Text="Founding spending cap (not funds granted)" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         <StackPanel Margin="0,0,8,8"><TextBlock Text="Protected cash floor (funds)" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding CashFloor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Spending limit (funds)" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding SpendingLimit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Population ceiling" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding ResidentLimit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Visitor allowance" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding VisitorLimit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Support reserve (Kerbin days)" Style="{StaticResource SmallLabel}"/><TextBox Text="{Binding ReserveDays, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,0,8,8"><TextBlock Text="Expansion policy" Style="{StaticResource SmallLabel}"/><ComboBox Text="{Binding GrowthPolicy, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"><ComboBoxItem Content="Approval required"/><ComboBoxItem Content="Automatic within charter"/><ComboBoxItem Content="Paused"/></ComboBox></StackPanel>
        </UniformGrid>
       </StackPanel></Expander>
      </StackPanel>
     </Border>
     <StackPanel x:Name="FoundingResidentsPanel" Visibility="Collapsed" Margin="0,0,8,8" Background="White">
      <TextBlock Text="Named founding residents" FontWeight="SemiBold" FontSize="12" Margin="8,6"/>
      <TextBlock Text="Review fills the target from eligible ordinary visitors first, excluding bootstrap workers and mission crew. Select preferred names below, or choose only selected names. Final names, homes, fares and recurring terms appear in the bill." FontSize="10" Foreground="#617787" TextWrapping="Wrap" Margin="8,0,8,6"/>
      <Expander Header="Preferred existing visitors — keep their current physical cabins" Margin="8,0,8,6"><ItemsControl x:Name="FoundingExistingChoices"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#617787" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
      <Expander Header="Preferred new arrivals — use actual named available crew / applicants" Margin="8,0,8,6"><ItemsControl x:Name="FoundingRecruitChoices"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#617787" FontSize="10" TextWrapping="Wrap"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
     </StackPanel>
     <Border x:Name="OperationFieldsPanel" Margin="0,0,0,8"><StackPanel>
      <ItemsControl x:Name="OperationFields" ItemTemplate="{StaticResource OperationFieldTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <Expander x:Name="StartupAdvanced" Header="Advanced startup settings — defaults" IsExpanded="False" Margin="0,6,8,0" Visibility="Collapsed"><StackPanel>
       <TextBlock Text="These reserve, service and production settings remain in the exact reviewed bill. Hidden local-production settings are retained when importing Supplies." TextWrapping="Wrap" FontSize="10" Foreground="#617787" Margin="0,5,0,8"/>
       <ItemsControl x:Name="AdvancedOperationFields" ItemTemplate="{StaticResource OperationFieldTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      </StackPanel></Expander>
     </StackPanel></Border>
      </StackPanel></ScrollViewer><Expander x:Name="RowsExpander" Grid.Row="2" Header="Catalog and current records" IsExpanded="True" Expanded="Records_ExpansionChanged" Collapsed="Records_ExpansionChanged" VerticalContentAlignment="Stretch" Margin="0,6,7,0"><Grid x:Name="RecordsTableHost"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RowsGrid" SelectionChanged="RowsGrid_SelectionChanged" MinHeight="180" MaxHeight="460">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Item / facility" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="State / blocker" Binding="{Binding State}" Width="1.4*" ElementStyle="{StaticResource GridText}"/>
       <DataGridTextColumn Header="Quantity / cost" Binding="{Binding Quantity}" Width="1.2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GridText}"><Setter Property="TextAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="Evidence" Binding="{Binding Provenance}" Width="1.2*" ElementStyle="{StaticResource GridText}"/>
      </DataGrid.Columns>
      </DataGrid><TextBlock x:Name="EmptyText" TextWrapping="Wrap" Foreground="#617787" Margin="14,50,14,14" IsHitTestVisible="False" VerticalAlignment="Top"/><Thumb x:Name="RecordsResizeHandle" Grid.Row="1" Height="12" Cursor="SizeNS" DragDelta="RecordsResizeHandle_DragDelta" KeyDown="RecordsResizeHandle_KeyDown" ToolTip="Drag to change the records table height; Up and Down keys resize it when focused" Focusable="True" Background="#DCE5E8" Margin="0,3,0,0"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3"><Rectangle Height="2" Width="42" Fill="#7E9BA4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb></Grid></Expander>
    </Grid>
     <Border x:Name="ActionArea" Grid.Row="2" Background="#F1F5F6" BorderBrush="#DCE5E8" BorderThickness="1" Padding="10" Margin="0,8,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="DetailText" Text="Choose an item for details." FontSize="12" TextWrapping="Wrap"/><Expander x:Name="QuotePanel" Header="Founding quote and approval" Visibility="Collapsed" Margin="0,7,0,0"><TextBlock x:Name="QuoteReviewText" TextWrapping="Wrap" Margin="0,5"/></Expander>
       <Expander x:Name="DiagnosticsPanel" Header="Details and error information" Visibility="Collapsed" FontSize="10" Foreground="#617787" Margin="0,7,0,0"><TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" FontSize="10"/></Expander>
      <Expander x:Name="SiteMapPanel" Header="Surveyed site map" Visibility="Collapsed" Margin="0,7,0,0"><StackPanel><TextBlock Text="Surveyed plot extents relative to the charter site. Placement clearance and physical terrain are rechecked by the runtime." Foreground="#617787" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,3"/><Canvas x:Name="SiteMapCanvas" Height="200" ClipToBounds="True" Background="#E7EFF1" SizeChanged="SiteMap_SizeChanged"/></StackPanel></Expander>
      </StackPanel><StackPanel Grid.Row="1"><ItemsControl x:Name="Actions" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,10,6" MaxWidth="270"><Button Content="{Binding Action.Label}" IsEnabled="{Binding Action.Available}" Tag="{Binding Action}" Click="Action_Click" Padding="12,7" FontSize="12" ToolTip="{Binding Action.Reason}" ToolTipService.ShowOnDisabled="True"/><TextBlock Text="{Binding Action.Reason}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Action.Reason}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding DetailVisibility}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#426674"/><Style.Triggers><DataTrigger Binding="{Binding Action.Available}" Value="False"><Setter Property="Foreground" Value="#A33325"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Expander Header="Full explanation" IsExpanded="{Binding IsExpanded,Mode=TwoWay}" Visibility="{Binding DetailVisibility}" FontSize="11" Foreground="#426674" Margin="0,3,0,0"><TextBlock Text="{Binding Action.Reason}" TextWrapping="Wrap" Margin="2,4,0,4"/></Expander></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="ActionFeedbackText" Foreground="#426674" FontSize="11" TextWrapping="Wrap"/>
      <Button x:Name="RetryButton" Content="Reconcile pending operation" Click="Retry_Click" Visibility="Collapsed" Padding="12,7" FontSize="12" HorizontalAlignment="Left" Margin="0,6,0,0"/>
      </StackPanel></Grid>
    </Border>
    </Grid></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
